{
 "name": "bn3",
 "duration": 52.22,
 "dialogue": [
  {
   "id": "bn3_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Бабушкины два миллиона. Сезон второй — финал. Тетрадь украли. Кажется, это *конец*.",
   "space": null
  },
  {
   "id": "bn3_02",
   "who": "narrator",
   "name": "",
   "start": 7.25,
   "caption": "Но утром руки сами достают кефир, зиру, чеснок, гранатовый сок. Ты делал этот маринад *каждый день* целый год.",
   "space": null
  },
  {
   "id": "bn3_03",
   "who": "narrator",
   "name": "",
   "start": 16.34,
   "caption": "Рецепт был не в тетради. Он был *в тебе*.",
   "space": null
  },
  {
   "id": "bn3_04",
   "who": "narrator",
   "name": "",
   "start": 19.51,
   "caption": "Через неделю напротив открывается чужая точка «Бабушкины». По украденному рецепту. И очередь у неё — *ноль*.",
   "space": null
  },
  {
   "id": "bn3_05",
   "who": "narrator",
   "name": "",
   "start": 27.26,
   "caption": "Потому что мясо должно ночевать в маринаде. А они спешили. А в суде твой юрист показывает видео с датой — и знак *аннулируют*.",
   "space": null
  },
  {
   "id": "bn3_06",
   "who": "narrator",
   "name": "",
   "start": 35.77,
   "caption": "Через месяц приходит посылка без обратного адреса. Внутри — бабушкина тетрадь. И записка: «Не получилось. *Извини*».",
   "space": null
  },
  {
   "id": "bn3_07",
   "who": "narrator",
   "name": "",
   "start": 44.94,
   "caption": "Конец второго сезона. Подпишись — завтра начнётся новая история.",
   "space": null
  }
 ],
