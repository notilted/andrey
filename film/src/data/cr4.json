{
 "name": "cr4",
 "duration": 81.65,
 "dialogue": [
  {
   "id": "cr4_01",
   "who": "narrator",
   "name": "",
   "start": 0.15,
   "caption": "Итоги голосования. За «рассказать дону» — восемь. Против — два. Явка выросла с одного человека до *десяти*. Рост девятьсот процентов. Дон бы мной гордился.",
   "space": null
  },
  {
   "id": "cr4_02",
   "who": "narrator",
   "name": "",
   "start": 13.14,
   "caption": "Особый привет амбасадору колбасы. С таким ником тебе прямая дорога *в картель*.",
   "space": null
  },
  {
   "id": "cr4_03",
   "who": "narrator",
   "name": "",
   "start": 18.61,
   "caption": "Вечер. Кабинет дона. Я кладу на стол фотографию. Переворачиваю. «Я жив. *Я всё знаю*».",
   "space": null
  },
  {
   "id": "cr4_04",
   "who": "narrator",
   "name": "",
   "start": 26.58,
   "caption": "Дон долго молчит. Потом говорит одно слово: *«Мендоса»*.",
   "space": null
  },
  {
   "id": "cr4_05",
   "who": "narrator",
   "name": "",
   "start": 31.64,
   "caption": "Мендоса — это второй картель в городе. Дон его ненавидит так, что даже апельсины теперь чистит *злее*.",
   "space": null
  },
  {
   "id": "cr4_06",
   "who": "narrator",
   "name": "",
   "start": 38.67,
   "caption": "«Чино работает на него. Значит, Мендоса знает про порт. Про сумку. И про *тебя*».",
   "space": null
  },
  {
   "id": "cr4_07",
   "who": "narrator",
   "name": "",
   "start": 44.9,
   "caption": "Дон открывает ящик стола и кладёт передо мной ключи от машины и адрес. Правило номер пять: *назад дороги нет*.",
   "space": null
  },
  {
   "id": "cr4_08",
   "who": "narrator",
   "name": "",
   "start": 53.75,
   "caption": "Мне шестнадцать. Прав нет. Водить я умею только велосипед. Но я теперь, сука, *водитель*.",
   "space": null
  },
  {
   "id": "cr4_09",
   "who": "narrator",
   "name": "",
   "start": 60.39,
   "caption": "А в дверях стоит Лусия, дочь дона. И говорит: «Я поеду *с тобой*».",
   "space": null
  },
  {
   "id": "cr4_10",
   "who": "narrator",
   "name": "",
   "start": 65.17,
   "caption": "Дон смотрит на неё. Потом на меня. Взгляд такой, будто он уже выбирает мне *гроб*.",
   "space": null
  },
  {
   "id": "cr4_11",
   "who": "narrator",
   "name": "",
   "start": 71.21,
   "caption": "Поехать одному — или взять Лусию? Пиши цифру. Явка десять человек — давайте сто. Я в вас верю, *суки*.",
   "space": null
  }
 ],
