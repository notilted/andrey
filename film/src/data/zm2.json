{
 "name": "zm2",
 "duration": 121.74,
 "dialogue": [
  {
   "id": "zm2_01",
   "who": "narrator",
   "name": "",
   "start": 0.6,
   "caption": "Ты открываешь. Папа вваливается в прихожую и сам задвигает шкаф обратно. Руки у него трясутся.",
   "space": null
  },
  {
   "id": "zm2_02",
   "who": "narrator",
   "name": "",
   "start": 8.21,
   "caption": "«Что с рукой?» — «Ерунда. Порезался о стекло».",
   "space": null
  },
  {
   "id": "zm2_03",
   "who": "narrator",
   "name": "",
   "start": 12.23,
   "caption": "Но ты видишь бинт. Сквозь него проступает ровный полукруг. *Следы зубов*.",
   "space": null
  },
  {
   "id": "zm2_04",
   "who": "narrator",
   "name": "",
   "start": 18.76,
   "caption": "Папа рассказывает: город закрыт. Мосты перекрыты. Мама — в больнице, там карантин, связи нет.",
   "space": null
  },
  {
   "id": "zm2_05",
   "who": "narrator",
   "name": "",
   "start": 26.91,
   "caption": "По радио — единственная станция. Голос военного: «Эвакуационный пункт — стадион. Последний транспорт — завтра в *восемнадцать ноль-ноль*».",
   "space": null
  },
  {
   "id": "zm2_06",
   "who": "narrator",
   "name": "",
   "start": 38.12,
   "caption": "До стадиона — шесть километров. Пешком. Через город, где на улицах — *они*.",
   "space": null
  },
  {
   "id": "zm2_07",
   "who": "narrator",
   "name": "",
   "start": 46.27,
   "caption": "Ночью ты не спишь. Папа сидит на кухне и смотрит в стену. Его знобит. Под глазами — серые круги.",
   "space": null
  },
  {
   "id": "zm2_08",
   "who": "narrator",
   "name": "",
   "start": 54.56,
   "caption": "В три часа он зовёт тебя. Тихо, чтобы не разбудить Соню.",
   "space": null
  },
  {
   "id": "zm2_09",
   "who": "narrator",
   "name": "",
   "start": 59.27,
   "caption": "«Послушай меня. Это не порез. У меня мало времени. Часов шесть. Может, меньше».",
   "space": null
  },
  {
   "id": "zm2_10",
   "who": "narrator",
   "name": "",
   "start": 65.4,
   "caption": "«Когда я перестану тебя узнавать — закроешь меня в ванной. И уведёшь Соню. *Обещай*».",
   "space": null
  },
  {
   "id": "zm2_11",
   "who": "narrator",
   "name": "",
   "start": 71.48,
   "caption": "Ты не можешь сказать ни слова. Он сам кладёт тебе в ладонь ключ.",
   "space": null
  },
  {
   "id": "zm2_12",
   "who": "narrator",
   "name": "",
   "start": 77.72,
   "caption": "Утро. Папа уже не отвечает. Он стоит в ванной лицом к зеркалу. И царапает его ногтями. *Медленно*.",
   "space": null
  },
  {
   "id": "zm2_13",
   "who": "narrator",
   "name": "",
   "start": 86.66,
   "caption": "Ты поворачиваешь ключ. Говоришь Соне, что папа заболел и догонит вас потом.",
   "space": null
  },
  {
   "id": "zm2_14",
   "who": "narrator",
   "name": "",
   "start": 92.87,
   "caption": "Рюкзак. Вода. Фонарик. Двенадцать часов дня. До последнего транспорта — *шесть часов*.",
   "space": null
  },
  {
   "id": "zm2_15",
   "who": "narrator",
   "name": "",
   "start": 100.65,
   "caption": "Вы выходите на лестницу. На третьем этаже дверь нараспашку. А на площадке — *тётя Галя*.",
   "space": null
  },
  {
   "id": "zm2_16",
   "who": "narrator",
   "name": "",
   "start": 108.0,
   "caption": "Она медленно поворачивает голову. И делает шаг к вам.",
   "space": null
  },
  {
   "id": "zm2_17",
   "who": "narrator",
   "name": "",
   "start": 113.17,
   "caption": "«Беги», — шепчешь ты. И вы *бежите*.",
   "space": null
  }
 ],
