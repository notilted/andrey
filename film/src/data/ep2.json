{
 "name": "ep2",
 "duration": 130.17,
 "dialogue": [
  {
   "id": "e2_galina_1",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 12.2,
   "caption": "Опять стучат…",
   "space": "bunker"
  },
  {
   "id": "e2_lev_1",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 18.48,
   "caption": "Время пошло *заново*.",
   "space": "bunker"
  },
  {
   "id": "e2_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 21.31,
   "caption": "Что значит — заново?",
   "space": "bunker"
  },
  {
   "id": "e2_lev_2",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 23.11,
   "caption": "Значит, мы здесь *уже были*.",
   "space": "bunker"
  },
  {
   "id": "e2_parrot_1",
   "who": "parrot",
   "name": "КЕША",
   "start": 28.06,
   "caption": "*Не открывай*. Не открывай.",
   "space": "bunker"
  },
  {
   "id": "e2_galina_2",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 30.7,
   "caption": "*Кеша*! Ты где такого набрался?",
   "space": "bunker"
  },
  {
   "id": "e2_alisa_1",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 33.1,
   "caption": "Пап… он говорит *твоим голосом*.",
   "space": "bunker"
  },
  {
   "id": "e2_mark_2",
   "who": "mark",
   "name": "МАРК",
   "start": 36.76,
   "caption": "Он не мог этого слышать. Я этого *ещё не говорил*.",
   "space": "bunker"
  },
  {
   "id": "e2_lev_3",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 40.31,
   "caption": "Ещё не говорили. *В этот раз*.",
   "space": "bunker"
  },
  {
   "id": "e2_lev_4",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 45.13,
   "caption": "*Двенадцать партий*. Я записываю каждую.",
   "space": "bunker"
  },
  {
   "id": "e2_mark_3",
   "who": "mark",
   "name": "МАРК",
   "start": 49.33,
   "caption": "Партий?",
   "space": "bunker"
  },
  {
   "id": "e2_lev_5",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 50.54,
   "caption": "Когда таймер доходит до нуля, *всё начинается снова*. И за дверью становится *на одного больше*.",
   "space": "bunker"
  },
  {
   "id": "e2_galina_3",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 60.18,
   "caption": "На одного *кого*?",
   "space": "bunker"
  },
  {
   "id": "e2_alisa_2",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 64.75,
   "caption": "Я это нарисовала дома. Но тут было *по-другому*.",
   "space": "bunker"
  },
  {
   "id": "e2_mark_4",
   "who": "mark",
   "name": "МАРК",
   "start": 70.22,
   "caption": "Когда ты это нарисовала?",
   "space": "bunker"
  },
  {
   "id": "e2_alisa_3",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 72.27,
   "caption": "Не помню. Пап, мне кажется, я это уже рисовала. *Много раз*.",
   "space": "bunker"
  },
  {
   "id": "e2_mark_5",
   "who": "mark",
   "name": "МАРК",
   "start": 80.88,
   "caption": "Если ты — это я… скажи, что Алиса *рисовала сегодня вечером*.",
   "space": "bunker"
  },
  {
   "id": "e2_double_1",
   "who": "double",
   "name": "ГОЛОС ЗА ДВЕРЬЮ",
   "start": 87.67,
   "caption": "*Дом. Солнце.* И два дерева.",
   "space": null
  },
  {
   "id": "e2_alisa_4",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 91.61,
   "caption": "Правильно…",
   "space": "bunker"
  },
  {
   "id": "e2_double_2",
   "who": "double",
   "name": "ГОЛОС ЗА ДВЕРЬЮ",
   "start": 93.58,
   "caption": "Теперь ты ответь. Как зовут *маму Алисы*?",
   "space": null
  },
  {
   "id": "e2_mark_6",
   "who": "mark",
   "name": "МАРК",
   "start": 101.13,
   "caption": "Я… *не помню*.",
   "space": "bunker"
  },
  {
   "id": "e2_galina_4",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 104.07,
   "caption": "Господи…",
   "space": "bunker"
  },
  {
   "id": "e2_alisa_5",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 114.45,
   "caption": "Пап?..",
   "space": "bunker"
  }
 ],
