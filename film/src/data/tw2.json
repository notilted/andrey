{
 "name": "tw2",
 "duration": 107.61,
 "dialogue": [
  {
   "id": "w2_01",
   "who": "narrator",
   "name": "",
   "start": 0.4,
   "caption": "Двенадцать часов. Столько у тебя есть, чтобы найти место, где твоя дочь *переживёт удар*.",
   "space": null
  },
  {
   "id": "w2_02",
   "who": "narrator",
   "name": "",
   "start": 6.12,
   "caption": "По карте ближайшее убежище — школа номер *четырнадцать*. Вы идёте туда через весь город.",
   "space": null
  },
  {
   "id": "w2_03",
   "who": "narrator",
   "name": "",
   "start": 12.92,
   "caption": "Город молчит. Машины брошены с *открытыми дверями*. Где-то воет собака.",
   "space": null
  },
  {
   "id": "w2_04",
   "who": "narrator",
   "name": "",
   "start": 18.78,
   "caption": "Вы доходите до школы. И видите, что школы *нет*.",
   "space": null
  },
  {
   "id": "w2_05",
   "who": "narrator",
   "name": "",
   "start": 22.99,
   "caption": "Убежище, которое назначило государство, стоит прямо на месте *первого удара*.",
   "space": null
  },
  {
   "id": "w2_06",
   "who": "narrator",
   "name": "",
   "start": 28.59,
   "caption": "Баба Галя садится на бордюр: «Всё. Дальше я *не пойду*».",
   "space": null
  },
  {
   "id": "w2_07",
   "who": "narrator",
   "name": "",
   "start": 33.34,
   "caption": "И тут Евгений, который молчал всю дорогу, говорит: «Под трамвайным депо есть *советский бункер*. Я там тридцать лет проработал».",
   "space": null
  },
  {
   "id": "w2_08",
   "who": "narrator",
   "name": "",
   "start": 42.42,
   "caption": "До депо — восемь километров. На таймере — *восемь часов*.",
   "space": null
  },
  {
   "id": "w2_09",
   "who": "narrator",
   "name": "",
   "start": 47.16,
   "caption": "Евгений сажает Соню себе на плечи. Хотя до этого ни разу ей *не улыбнулся*.",
   "space": null
  },
  {
   "id": "w2_10",
   "who": "narrator",
   "name": "",
   "start": 53.01,
   "caption": "Баба Галя хромает, но шутит: «Меня, деточка, *так просто* не убьёшь».",
   "space": null
  },
  {
   "id": "w2_11",
   "who": "narrator",
   "name": "",
   "start": 58.78,
   "caption": "Час до удара. Вы у ворот депо. А у входа в бункер — *охрана*.",
   "space": null
  },
  {
   "id": "w2_12",
   "who": "narrator",
   "name": "",
   "start": 64.09,
   "caption": "Молодой парень с автоматом смотрит в список: «Сорок мест. Только по списку. *Вас нет*».",
   "space": null
  },
  {
   "id": "w2_13",
   "who": "narrator",
   "name": "",
   "start": 70.92,
   "caption": "Евгений замирает. Долго смотрит на парня. И молча отводит его *в сторону*.",
   "space": null
  },
  {
   "id": "w2_14",
   "who": "narrator",
   "name": "",
   "start": 77.38,
   "caption": "Через минуту вас *пускают*. Что он ему сказал — ты не знаешь.",
   "space": null
  },
  {
   "id": "w2_15",
   "who": "narrator",
   "name": "",
   "start": 83.62,
   "caption": "Удар второй волны. Бункер трясёт так, что *гаснет свет*.",
   "space": null
  },
  {
   "id": "w2_16",
   "who": "narrator",
   "name": "",
   "start": 88.69,
   "caption": "Евгений светит фонариком на гермодверь. И *бледнеет*.",
   "space": null
  },
  {
   "id": "w2_17",
   "who": "narrator",
   "name": "",
   "start": 92.76,
   "caption": "«Механизм сорван. Изнутри её *не закрыть*».",
   "space": null
  },
  {
   "id": "w2_18",
   "who": "narrator",
   "name": "",
   "start": 96.39,
   "caption": "И в эту секунду приходит новое оповещение: «Третья волна. *Основное тело*. Сорок восемь часов».",
   "space": null
  }
 ],
