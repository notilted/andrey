{
 "name": "lf1",
 "duration": 41.58,
 "dialogue": [
  {
   "id": "lf1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Лифт дёрнулся и встал между этажами. Что делать? Пять правил, которые *реально работают*.",
   "space": null
  },
  {
   "id": "lf1_02",
   "who": "narrator",
   "name": "",
   "start": 6.85,
   "caption": "Первое: не паникуй и не прыгай. Лифт от этого не поедет — только *раскачаешь кабину*.",
   "space": null
  },
  {
   "id": "lf1_03",
   "who": "narrator",
   "name": "",
   "start": 13.03,
   "caption": "Второе: нажми кнопку вызова диспетчера — ту, что с *колокольчиком*.",
   "space": null
  },
  {
   "id": "lf1_04",
   "who": "narrator",
   "name": "",
   "start": 17.83,
   "caption": "Третье: никто не ответил — звони *сто двенадцать*. С мобильного это бесплатно.",
   "space": null
  },
  {
   "id": "lf1_05",
   "who": "narrator",
   "name": "",
   "start": 23.55,
   "caption": "Четвёртое: не разжимай двери и не лезь в люк. Кабина может *тронуться* в любой момент.",
   "space": null
  },
  {
   "id": "lf1_06",
   "who": "narrator",
   "name": "",
   "start": 29.53,
   "caption": "Пятое: береги заряд телефона и жди. *Помощь приедет*.",
   "space": null
  },
  {
   "id": "lf1_07",
   "who": "narrator",
   "name": "",
   "start": 34.67,
   "caption": "Сохрани, чтобы не забыть. Подпишись — каждый день новые истории.",
   "space": null
  }
 ],
