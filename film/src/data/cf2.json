{
 "name": "cf2",
 "duration": 43.15,
 "dialogue": [
  {
   "id": "cf2_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Чужой телефон. Часть вторая. Такси сворачивает в тёмный двор и *гасит фары*.",
   "space": null
  },
  {
   "id": "cf2_02",
   "who": "narrator",
   "name": "",
   "start": 6.08,
   "caption": "Водитель шепчет: от самого твоего дома за нами ехала машина. Серая. *Без передних номеров*.",
   "space": null
  },
  {
   "id": "cf2_03",
   "who": "narrator",
   "name": "",
   "start": 12.54,
   "caption": "Он не похититель. Он просто *заметил хвост*.",
   "space": null
  },
  {
   "id": "cf2_04",
   "who": "narrator",
   "name": "",
   "start": 15.82,
   "caption": "Серая машина медленно проезжает мимо двора. И останавливается *в конце улицы*.",
   "space": null
  },
  {
   "id": "cf2_05",
   "who": "narrator",
   "name": "",
   "start": 21.34,
   "caption": "Ровно через двадцать минут чужой телефон звонит снова. Голос спокойный: привези телефон к старому мосту — если хочешь узнать, *кто тебя фотографировал*.",
   "space": null
  },
  {
   "id": "cf2_06",
   "who": "narrator",
   "name": "",
   "start": 31.54,
   "caption": "Таксист качает головой: не езди. Но ты уже *открываешь дверь*.",
   "space": null
  },
  {
   "id": "cf2_07",
   "who": "narrator",
   "name": "",
   "start": 36.55,
   "caption": "Финал — завтра в семь вечера. Подпишись, чтобы не пропустить.",
   "space": null
  }
 ],
