{
 "name": "bm2",
 "duration": 116.63,
 "dialogue": [
  {
   "id": "b2_01",
   "who": "narrator",
   "name": "",
   "start": 0.5,
   "caption": "Первый покупатель приходит на второй день. Берёт шаурму, откусывает. И она *разваливается* у него в руках.",
   "space": null
  },
  {
   "id": "b2_02",
   "who": "narrator",
   "name": "",
   "start": 8.04,
   "caption": "Лаваш рвётся. Соус течёт по пальцам. Он молча выбрасывает её в урну. *У тебя на глазах*.",
   "space": null
  },
  {
   "id": "b2_03",
   "who": "narrator",
   "name": "",
   "start": 15.96,
   "caption": "Первый месяц. В кассе — четыре тысячи в день. А чтобы просто не уходить в минус, нужно *двадцать пять*.",
   "space": null
  },
  {
   "id": "b2_04",
   "who": "narrator",
   "name": "",
   "start": 23.81,
   "caption": "И ты замечаешь странное. Мяса закупаешь на пятьдесят порций в день. А продаёшь — *тридцать*.",
   "space": null
  },
  {
   "id": "b2_05",
   "who": "narrator",
   "name": "",
   "start": 31.32,
   "caption": "Ты ставишь камеру. И видишь, как Лена пробивает чек, потом *отменяет* его — и кладёт деньги в карман.",
   "space": null
  },
  {
   "id": "b2_06",
   "who": "narrator",
   "name": "",
   "start": 38.55,
   "caption": "А Рустам по вечерам уходит с пакетом. В пакете — *твоё мясо*.",
   "space": null
  },
  {
   "id": "b2_07",
   "who": "narrator",
   "name": "",
   "start": 43.83,
   "caption": "Ты увольняешь обоих. Теперь ты сам и повар, и кассир, и уборщик. Встаёшь в пять. Ложишься в час.",
   "space": null
  },
  {
   "id": "b2_08",
   "who": "narrator",
   "name": "",
   "start": 53.35,
   "caption": "А через месяц через дорогу начинают *ремонт*.",
   "space": null
  },
  {
   "id": "b2_09",
   "who": "narrator",
   "name": "",
   "start": 56.31,
   "caption": "Красная вывеска. Сорок точек по городу. «Шаурма-Кинг». И баннер на всю витрину: «Шаурма — *девяносто девять рублей*».",
   "space": null
  },
  {
   "id": "b2_10",
   "who": "narrator",
   "name": "",
   "start": 65.88,
   "caption": "У тебя — двести восемьдесят. Дешевле ты не можешь: одно мясо стоит *сто десять*.",
   "space": null
  },
  {
   "id": "b2_11",
   "who": "narrator",
   "name": "",
   "start": 72.04,
   "caption": "Студенты уходят к ним. У них очередь до остановки. У тебя — *пусто*.",
   "space": null
  },
  {
   "id": "b2_12",
   "who": "narrator",
   "name": "",
   "start": 78.44,
   "caption": "А в пятницу утром в дверь стучат. Проверка. Анонимная жалоба: «Отравился шаурмой».",
   "space": null
  },
  {
   "id": "b2_13",
   "who": "narrator",
   "name": "",
   "start": 85.61,
   "caption": "Ты никого не травил. Но точку закрывают *на неделю*. До выяснения.",
   "space": null
  },
  {
   "id": "b2_14",
   "who": "narrator",
   "name": "",
   "start": 91.18,
   "caption": "На счёте — *одиннадцать тысяч*. Аренду платить через три дня.",
   "space": null
  },
  {
   "id": "b2_15",
   "who": "narrator",
   "name": "",
   "start": 96.24,
   "caption": "Ночью ты пишешь объявление: «Продаётся готовый бизнес. *Недорого*». Палец — над кнопкой «Опубликовать».",
   "space": null
  },
  {
   "id": "b2_16",
   "who": "narrator",
   "name": "",
   "start": 105.59,
   "caption": "И тут звонит мама: «Я разбирала бабушкины вещи. Тут коробка. На ней — *твоё имя*».",
   "space": null
  }
 ],
