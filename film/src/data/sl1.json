{
 "name": "sl1",
 "duration": 48.44,
 "dialogue": [
  {
   "id": "sl1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Одиннадцать одиннадцать — день гигантских распродаж. И пять приёмов, на которые ты *точно попадался*.",
   "space": null
  },
  {
   "id": "sl1_02",
   "who": "narrator",
   "name": "",
   "start": 7.21,
   "caption": "Первый: зачёркнутая цена. Её бывает поднимают незадолго до акции — и минус пятьдесят процентов выглядит как *подарок*.",
   "space": null
  },
  {
   "id": "sl1_03",
   "who": "narrator",
   "name": "",
   "start": 15.77,
   "caption": "Второй: «осталось две штуки» и таймер. Спешка *выключает голову*.",
   "space": null
  },
  {
   "id": "sl1_04",
   "who": "narrator",
   "name": "",
   "start": 21.38,
   "caption": "Третий: бесплатная доставка от двух тысяч. И вот ты докупаешь носки, которые *не нужны*.",
   "space": null
  },
  {
   "id": "sl1_05",
   "who": "narrator",
   "name": "",
   "start": 27.79,
   "caption": "Четвёртый: оплата частями. Четыре платежа кажутся мелочью — пока их не стало *десять*.",
   "space": null
  },
  {
   "id": "sl1_06",
   "who": "narrator",
   "name": "",
   "start": 34.35,
   "caption": "Пятый: «вам может понравиться». Пришёл за одним — ушёл *с пятью*.",
   "space": null
  },
  {
   "id": "sl1_07",
   "who": "narrator",
   "name": "",
   "start": 39.96,
   "caption": "Совет: перед покупкой проверь историю цены. Подпишись — каждый день новые истории.",
   "space": null
  }
 ],
