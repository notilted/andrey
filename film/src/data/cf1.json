{
 "name": "cf1",
 "duration": 40.54,
 "dialogue": [
  {
   "id": "cf1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Чужой телефон. Часть первая. Ты садишься в такси — и на заднем сиденье *звонит телефон*. Не твой.",
   "space": null
  },
  {
   "id": "cf1_02",
   "who": "narrator",
   "name": "",
   "start": 7.66,
   "caption": "Водитель пожимает плечами: пассажир до вас забыл. Ты берёшь трубку. Тишина. А потом — *твоё имя*.",
   "space": null
  },
  {
   "id": "cf1_03",
   "who": "narrator",
   "name": "",
   "start": 16.01,
   "caption": "Звонок обрывается. Новое сообщение: «Не выключай. Через двадцать минут *он позвонит снова*».",
   "space": null
  },
  {
   "id": "cf1_04",
   "who": "narrator",
   "name": "",
   "start": 22.78,
   "caption": "Ты открываешь галерею. Там твой подъезд. Твоё окно. *Сегодняшнее* фото.",
   "space": null
  },
  {
   "id": "cf1_05",
   "who": "narrator",
   "name": "",
   "start": 28.63,
   "caption": "Таксист смотрит на тебя в зеркало. И молча сворачивает *не туда*.",
   "space": null
  },
  {
   "id": "cf1_06",
   "who": "narrator",
   "name": "",
   "start": 33.36,
   "caption": "Часть вторая — завтра в семь вечера. Подпишись, чтобы не пропустить.",
   "space": null
  }
 ],
