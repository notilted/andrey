{
 "name": "gt1",
 "duration": 40.0,
 "dialogue": [
  {
   "id": "gt1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Тринадцать лет ожидания. И вот — *день релиза*.",
   "space": null
  },
  {
   "id": "gt1_02",
   "who": "narrator",
   "name": "",
   "start": 4.13,
   "caption": "Марк взял отгул, закупил энергетики и выключил телефон.",
   "space": null
  },
  {
   "id": "gt1_03",
   "who": "narrator",
   "name": "",
   "start": 8.29,
   "caption": "Полночь. Загрузка. Девяносто девять процентов…",
   "space": null
  },
  {
   "id": "gt1_04",
   "who": "narrator",
   "name": "",
   "start": 12.03,
   "caption": "И свет гаснет. *Во всём доме*.",
   "space": null
  },
  {
   "id": "gt1_05",
   "who": "narrator",
   "name": "",
   "start": 14.85,
   "caption": "Сосед с перфоратором? Нет. Это весь район в одну секунду включил приставки.",
   "space": null
  },
  {
   "id": "gt1_06",
   "who": "narrator",
   "name": "",
   "start": 20.24,
   "caption": "Марк зажёг свечу, сел перед чёрным экраном и прошептал: тринадцать лет ждал — подожду ещё час.",
   "space": null
  },
  {
   "id": "gt1_07",
   "who": "narrator",
   "name": "",
   "start": 27.66,
   "caption": "Через час свет дали. А сервера — *нет*.",
   "space": null
  },
  {
   "id": "gt1_08",
   "who": "narrator",
   "name": "",
   "start": 31.61,
   "caption": "Подпишись — каждый день новые истории. А в семь вечера — вторая часть «Без сигнала».",
   "space": null
  }
 ],
