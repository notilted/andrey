{
 "name": "tw3",
 "duration": 112.49,
 "dialogue": [
  {
   "id": "w3_01",
   "who": "narrator",
   "name": "",
   "start": 0.4,
   "caption": "Двое суток. Ты думал, это много. Пока не узнал, что дверь закрывается *только снаружи*.",
   "space": null
  },
  {
   "id": "w3_02",
   "who": "narrator",
   "name": "",
   "start": 6.62,
   "caption": "Евгений не спит. Разбирает механизм снова и снова. *Ничего не выходит*.",
   "space": null
  },
  {
   "id": "w3_03",
   "who": "narrator",
   "name": "",
   "start": 12.8,
   "caption": "Баба Галя распускает свой шарф. И вяжет Соне *нового зайца*.",
   "space": null
  },
  {
   "id": "w3_04",
   "who": "narrator",
   "name": "",
   "start": 17.66,
   "caption": "Соня рисует вас всех. Пятерых. Вместе с *Барсиком*.",
   "space": null
  },
  {
   "id": "w3_05",
   "who": "narrator",
   "name": "",
   "start": 22.51,
   "caption": "Ночью Евгений сидит у двери со старой *фотографией*. На ней мальчик лет десяти.",
   "space": null
  },
  {
   "id": "w3_06",
   "who": "narrator",
   "name": "",
   "start": 27.99,
   "caption": "«Сын, — говорит он. — Семь лет не разговариваем. Я ему тогда *такого наговорил*…»",
   "space": null
  },
  {
   "id": "w3_07",
   "who": "narrator",
   "name": "",
   "start": 34.7,
   "caption": "А охранник со списком весь вечер *не сводит глаз* с Евгения.",
   "space": null
  },
  {
   "id": "w3_08",
   "who": "narrator",
   "name": "",
   "start": 38.89,
   "caption": "И ты понимаешь. Это и есть его *сын*. Вот почему вас пустили.",
   "space": null
  },
  {
   "id": "w3_09",
   "who": "narrator",
   "name": "",
   "start": 44.8,
   "caption": "Час до удара. Кто-то должен остаться снаружи и закрутить колесо *вручную*.",
   "space": null
  },
  {
   "id": "w3_10",
   "who": "narrator",
   "name": "",
   "start": 50.1,
   "caption": "Ты делаешь шаг к двери. Евгений толкает тебя обратно: «У тебя *дочь*. А этот механизм я знаю лучше всех».",
   "space": null
  },
  {
   "id": "w3_11",
   "who": "narrator",
   "name": "",
   "start": 58.26,
   "caption": "Он отдаёт тебе сложенную записку: «Передай ему. *Потом*. Не сейчас».",
   "space": null
  },
  {
   "id": "w3_12",
   "who": "narrator",
   "name": "",
   "start": 64.31,
   "caption": "Соня протягивает ему вязаного зайца. Чтобы ему было *не страшно*.",
   "space": null
  },
  {
   "id": "w3_13",
   "who": "narrator",
   "name": "",
   "start": 69.01,
   "caption": "Он улыбается. Второй раз *за всё время*.",
   "space": null
  },
  {
   "id": "w3_14",
   "who": "narrator",
   "name": "",
   "start": 73.42,
   "caption": "Дверь закрывается. Колесо медленно поворачивается. И *останавливается*.",
   "space": null
  },
  {
   "id": "w3_15",
   "who": "narrator",
   "name": "",
   "start": 83.25,
   "caption": "Через три дня вы выходите наружу. Небо оранжевое. Тихо. У двери лежит *вязаный заяц*.",
   "space": null
  },
  {
   "id": "w3_16",
   "who": "narrator",
   "name": "",
   "start": 91.07,
   "caption": "Ты отдаёшь записку его сыну. «Прости меня. Я *горжусь тобой*. Папа».",
   "space": null
  },
  {
   "id": "w3_17",
   "who": "narrator",
   "name": "",
   "start": 96.91,
   "caption": "Парень садится у двери. И *плачет*.",
   "space": null
  },
  {
   "id": "w3_18",
   "who": "narrator",
   "name": "",
   "start": 100.4,
   "caption": "Соня берёт тебя за руку. И телефон в твоей руке снова *загорается*.",
   "space": null
  },
  {
   "id": "w3_19",
   "who": "narrator",
   "name": "",
   "start": 105.55,
   "caption": "«Обнаружен *новый объект*».",
   "space": null
  }
 ],
