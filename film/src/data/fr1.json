{
 "name": "fr1",
 "duration": 45.16,
 "dialogue": [
  {
   "id": "fr1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Сегодня пятница, тринадцатое. И это уже *третья* в этом году — после февраля и марта.",
   "space": null
  },
  {
   "id": "fr1_02",
   "who": "narrator",
   "name": "",
   "start": 6.25,
   "caption": "У страха перед этим днём есть название: *параскаведекатриафобия*. Попробуй выговорить.",
   "space": null
  },
  {
   "id": "fr1_03",
   "who": "narrator",
   "name": "",
   "start": 12.36,
   "caption": "Во многих зданиях мира нет тринадцатого этажа — после двенадцатого сразу *четырнадцатый*. А в некоторых самолётах нет тринадцатого ряда.",
   "space": null
  },
  {
   "id": "fr1_04",
   "who": "narrator",
   "name": "",
   "start": 21.53,
   "caption": "Следующая пятница, тринадцатое — только в *августе* двадцать седьмого.",
   "space": null
  },
  {
   "id": "fr1_05",
   "who": "narrator",
   "name": "",
   "start": 26.29,
   "caption": "Марк смеётся над приметами. Заходит в лифт. Жмёт свой этаж — четырнадцатый. Лифт едет… и останавливается *на тринадцатом*.",
   "space": null
  },
  {
   "id": "fr1_06",
   "who": "narrator",
   "name": "",
   "start": 36.36,
   "caption": "Подпишись — каждый день новые истории. А в семь вечера — вторая часть «Бабушкиных двух миллионов».",
   "space": null
  }
 ],
