{
 "name": "zm1",
 "duration": 123.55,
 "dialogue": [
  {
   "id": "zm1_01",
   "who": "narrator",
   "name": "",
   "start": 1.4,
   "caption": "Шесть утра. Тебя будит не будильник. Тебя будит *крик* за стеной.",
   "space": null
  },
  {
   "id": "zm1_02",
   "who": "narrator",
   "name": "",
   "start": 6.56,
   "caption": "Телефон разрывается от оповещений: «Режим ЧС. Оставайтесь дома. Не открывайте двери *никому*».",
   "space": null
  },
  {
   "id": "zm1_03",
   "who": "narrator",
   "name": "",
   "start": 14.41,
   "caption": "В новостях говорят про вспышку бешенства. Говорят спокойно. Но за спиной ведущего бегут люди. И кто-то, кто *за ними гонится*.",
   "space": null
  },
  {
   "id": "zm1_04",
   "who": "narrator",
   "name": "",
   "start": 24.1,
   "caption": "Родители ещё вечером уехали в ночную смену. Дома только ты и сестра. Соне *восемь*.",
   "space": null
  },
  {
   "id": "zm1_05",
   "who": "narrator",
   "name": "",
   "start": 30.96,
   "caption": "«Это учения?» — спрашивает она. Ты говоришь «да». И впервые в жизни ей *врёшь*.",
   "space": null
  },
  {
   "id": "zm1_06",
   "who": "narrator",
   "name": "",
   "start": 38.08,
   "caption": "Ты смотришь в окно. Во дворе — соседка, тётя Галя. Она стоит у подъезда и не двигается. Просто смотрит *вверх*. На ваши окна.",
   "space": null
  },
  {
   "id": "zm1_07",
   "who": "narrator",
   "name": "",
   "start": 48.08,
   "caption": "Дворник подходит к ней и трогает за плечо. И она *кусает его*. В шею.",
   "space": null
  },
  {
   "id": "zm1_08",
   "who": "narrator",
   "name": "",
   "start": 55.12,
   "caption": "Ты задёргиваешь шторы. Двигаешь к двери шкаф. Холодильник. Всё, что можешь сдвинуть.",
   "space": null
  },
  {
   "id": "zm1_09",
   "who": "narrator",
   "name": "",
   "start": 61.7,
   "caption": "Пишешь маме — сообщение не уходит. Пишешь папе — *одна галочка*.",
   "space": null
  },
  {
   "id": "zm1_10",
   "who": "narrator",
   "name": "",
   "start": 68.76,
   "caption": "Восемь вечера. В подъезде кто-то ходит. Медленно. Шаркая. Останавливается у каждой двери. И *нюхает*.",
   "space": null
  },
  {
   "id": "zm1_11",
   "who": "narrator",
   "name": "",
   "start": 78.21,
   "caption": "Шаги останавливаются у вашей.",
   "space": null
  },
  {
   "id": "zm1_12",
   "who": "narrator",
   "name": "",
   "start": 81.11,
   "caption": "Соня сжимает твою руку так сильно, что белеют пальцы. Вы не дышите.",
   "space": null
  },
  {
   "id": "zm1_13",
   "who": "narrator",
   "name": "",
   "start": 88.55,
   "caption": "Тишина. Минута. Две. Шаги уходят *вниз*.",
   "space": null
  },
  {
   "id": "zm1_14",
   "who": "narrator",
   "name": "",
   "start": 94.83,
   "caption": "А в полночь — стук. Три удара. Так всегда стучал папа. И его голос: «Сынок, открой. Это я. Быстрее».",
   "space": null
  },
  {
   "id": "zm1_15",
   "who": "narrator",
   "name": "",
   "start": 104.69,
   "caption": "Ты смотришь в глазок. Это правда папа. Живой. Только рукав куртки — *в крови*. И руку он прячет за спину.",
   "space": null
  },
  {
   "id": "zm1_16",
   "who": "narrator",
   "name": "",
   "start": 113.8,
   "caption": "Соня уже бежит к двери: «Папа!»",
   "space": null
  },
  {
   "id": "zm1_17",
   "who": "narrator",
   "name": "",
   "start": 118.02,
   "caption": "А ты бы *открыл*?",
   "space": null
  }
 ],
