{
 "name": "bn2",
 "duration": 52.06,
 "dialogue": [
  {
   "id": "bn2_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Бабушкины два миллиона. Сезон второй, часть вторая. Юрист говорит прямо: знак принадлежит тому, кто *первым* его зарегистрировал.",
   "space": null
  },
  {
   "id": "bn2_02",
   "who": "narrator",
   "name": "",
   "start": 9.48,
   "caption": "Два пути. Сменить название и все вывески. Или бороться — если доказать, что ты пользовался именем *раньше*.",
   "space": null
  },
  {
   "id": "bn2_03",
   "who": "narrator",
   "name": "",
   "start": 17.59,
   "caption": "Нужны доказательства: чеки, договоры, фото вывески — *с датами*.",
   "space": null
  },
  {
   "id": "bn2_04",
   "who": "narrator",
   "name": "",
   "start": 22.69,
   "caption": "И ты вспоминаешь: год назад студент снял видео у твоей точки. Миллион просмотров. А на заднем плане — вывеска «Бабушкины» и *дата публикации*.",
   "space": null
  },
  {
   "id": "bn2_05",
   "who": "narrator",
   "name": "",
   "start": 33.44,
   "caption": "Впервые за неделю ты выдыхаешь. Ночью приходишь закрыть кассу — и видишь: дверь *приоткрыта*.",
   "space": null
  },
  {
   "id": "bn2_06",
   "who": "narrator",
   "name": "",
   "start": 40.85,
   "caption": "Деньги на месте. Пропало только одно — *бабушкина тетрадь*.",
   "space": null
  },
  {
   "id": "bn2_07",
   "who": "narrator",
   "name": "",
   "start": 45.46,
   "caption": "Финал — завтра в семь вечера. Подпишись, чтобы не пропустить.",
   "space": null
  }
 ],
