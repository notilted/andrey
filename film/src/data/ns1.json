{
 "name": "ns1",
 "duration": 40.85,
 "dialogue": [
  {
   "id": "ns1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Что будет, если не спать сутки? Спойлер: ты будешь *как пьяный*.",
   "space": null
  },
  {
   "id": "ns1_02",
   "who": "narrator",
   "name": "",
   "start": 5.11,
   "caption": "Через семнадцать часов без сна реакция — как у человека с *половиной промилле* в крови.",
   "space": null
  },
  {
   "id": "ns1_03",
   "who": "narrator",
   "name": "",
   "start": 11.08,
   "caption": "Через двадцать четыре часа — как с *целым промилле*. За руль в таком состоянии нельзя.",
   "space": null
  },
  {
   "id": "ns1_04",
   "who": "narrator",
   "name": "",
   "start": 17.23,
   "caption": "Мозг начинает отключаться кусками: микросон на пару секунд. И ты его *даже не заметишь*.",
   "space": null
  },
  {
   "id": "ns1_05",
   "who": "narrator",
   "name": "",
   "start": 23.97,
   "caption": "Растёт аппетит — особенно на *сладкое* и фастфуд.",
   "space": null
  },
  {
   "id": "ns1_06",
   "who": "narrator",
   "name": "",
   "start": 27.78,
   "caption": "И вернуть всё помогает только сон. Не кофе. Не энергетик. *Сон*.",
   "space": null
  },
  {
   "id": "ns1_07",
   "who": "narrator",
   "name": "",
   "start": 33.46,
   "caption": "Отправь другу, который сидит до утра. Подпишись — каждый день новые истории.",
   "space": null
  }
 ],
