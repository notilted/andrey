{
 "name": "bs2",
 "duration": 48.91,
 "dialogue": [
  {
   "id": "bs2_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Без сигнала. Часть вторая. Прошло шесть часов — света нет *во всём городе*.",
   "space": null
  },
  {
   "id": "bs2_02",
   "who": "narrator",
   "name": "",
   "start": 6.47,
   "caption": "Марк идёт в магазин. Касса не работает, терминал мёртвый. На двери: *только наличные*.",
   "space": null
  },
  {
   "id": "bs2_03",
   "who": "narrator",
   "name": "",
   "start": 13.68,
   "caption": "А наличных у Марка — ноль. Всё на карте. Банкомат тоже *чёрный*.",
   "space": null
  },
  {
   "id": "bs2_04",
   "who": "narrator",
   "name": "",
   "start": 19.38,
   "caption": "Дома из крана течёт тонкая струйка — и всё. Насосам, которые качают воду наверх, тоже нужен *свет*.",
   "space": null
  },
  {
   "id": "bs2_05",
   "who": "narrator",
   "name": "",
   "start": 26.56,
   "caption": "Холодильник тает. Телефон — три процента. Новостей нет, и никто не знает, *когда всё вернут*.",
   "space": null
  },
  {
   "id": "bs2_06",
   "who": "narrator",
   "name": "",
   "start": 33.76,
   "caption": "К вечеру во дворе собираются соседи. И кто-то говорит: у меня есть генератор… но бензина *на всех не хватит*.",
   "space": null
  },
  {
   "id": "bs2_07",
   "who": "narrator",
   "name": "",
   "start": 41.39,
   "caption": "Часть третья — завтра в семь вечера. Подпишись, чтобы не пропустить.",
   "space": null
  }
 ],
