{
 "name": "tw4",
 "duration": 86.67,
 "dialogue": [
  {
   "id": "w4_01",
   "who": "narrator",
   "name": "",
   "start": 0.5,
   "caption": "Метеориты не умеют тормозить. Этот — *затормозил*.",
   "space": null
  },
  {
   "id": "w4_02",
   "who": "narrator",
   "name": "",
   "start": 5.2,
   "caption": "Прошла неделя после третьей волны. Вы живёте в трамвайном депо. Старший теперь — *Дима*.",
   "space": null
  },
  {
   "id": "w4_03",
   "who": "narrator",
   "name": "",
   "start": 11.69,
   "caption": "Записку отца он носит в нагрудном кармане. И каждое утро её *перечитывает*.",
   "space": null
  },
  {
   "id": "w4_04",
   "who": "narrator",
   "name": "",
   "start": 17.55,
   "caption": "Соня не расстаётся с *вязаным зайцем*. Баба Галя печёт лепёшки на костре. Барсик их ворует.",
   "space": null
  },
  {
   "id": "w4_05",
   "who": "narrator",
   "name": "",
   "start": 24.86,
   "caption": "А телефоны каждый день показывают одно и то же: «Расчёт траектории». *Таймера нет*.",
   "space": null
  },
  {
   "id": "w4_06",
   "who": "narrator",
   "name": "",
   "start": 31.53,
   "caption": "Ночью экран меняется: «Объект *снижает скорость*».",
   "space": null
  },
  {
   "id": "w4_07",
   "who": "narrator",
   "name": "",
   "start": 35.87,
   "caption": "Дима долго смотрит на телефон: «Такого *не бывает*».",
   "space": null
  },
  {
   "id": "w4_08",
   "who": "narrator",
   "name": "",
   "start": 40.31,
   "caption": "Под утро объект проходит над городом *без звука*. И садится в поле за рекой.",
   "space": null
  },
  {
   "id": "w4_09",
   "who": "narrator",
   "name": "",
   "start": 45.88,
   "caption": "Ни взрыва. Ни волны. *Тишина*.",
   "space": null
  },
  {
   "id": "w4_10",
   "who": "narrator",
   "name": "",
   "start": 49.69,
   "caption": "Дима едет посмотреть, ты — с ним. Соня отдаёт тебе *зайца*: «Чтобы тебе было не страшно».",
   "space": null
  },
  {
   "id": "w4_11",
   "who": "narrator",
   "name": "",
   "start": 56.77,
   "caption": "В поле стоит гладкий *чёрный камень* размером с дом. Тёплый. Без единой царапины.",
   "space": null
  },
  {
   "id": "w4_12",
   "who": "narrator",
   "name": "",
   "start": 63.11,
   "caption": "Ты касаешься его рукой. И камень *отвечает* — тихим гулом.",
   "space": null
  },
  {
   "id": "w4_13",
   "who": "narrator",
   "name": "",
   "start": 67.93,
   "caption": "В нём открывается узкая *щель*. Изнутри падает белый свет.",
   "space": null
  },
  {
   "id": "w4_14",
   "who": "narrator",
   "name": "",
   "start": 72.94,
   "caption": "И в эту секунду у вас *звонят телефоны*. Хотя связи нет уже неделю.",
   "space": null
  },
  {
   "id": "w4_15",
   "who": "narrator",
   "name": "",
   "start": 78.45,
   "caption": "На экране — номер, который ты знаешь. *Евгений*.",
   "space": null
  }
 ],
