{
 "name": "film",
 "duration": 217.93,
 "dialogue": [
  {
   "id": "s1_alisa_1",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 10.3,
   "caption": "Пап… а что это *значит*?",
   "space": "room"
  },
  {
   "id": "s1_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 12.75,
   "caption": "Одевайся. Нам нужно *в укрытие*.",
   "space": "room"
  },
  {
   "id": "s1_announce",
   "who": "announcer",
   "name": "ОПОВЕЩЕНИЕ",
   "start": 15.88,
   "caption": "Внимание! *Ракетная опасность*. Всем немедленно пройти в ближайшее *укрытие*.",
   "space": null
  },
  {
   "id": "s1_alisa_2",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 20.74,
   "caption": "А куда мы пойдём?",
   "space": "room"
  },
  {
   "id": "s1_mark_3",
   "who": "mark",
   "name": "МАРК",
   "start": 22.24,
   "caption": "В подвал. Там *убежище*.",
   "space": "room"
  },
  {
   "id": "s1_mark_2",
   "who": "mark",
   "name": "МАРК",
   "start": 29.84,
   "caption": "Это… *мой номер*.",
   "space": "room"
  },
  {
   "id": "s2_mark_0",
   "who": "mark",
   "name": "МАРК",
   "start": 42.38,
   "caption": "Держись за перила. Не беги.",
   "space": "stairs"
  },
  {
   "id": "s2_galina_1",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 45.6,
   "caption": "Подождите! А *животных*-то брать разрешили?",
   "space": "stairs"
  },
  {
   "id": "s2_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 48.46,
   "caption": "Думаю, да.",
   "space": "stairs"
  },
  {
   "id": "s2_galina_2",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 49.81,
   "caption": "А то я *кота* потеряла.",
   "space": "stairs"
  },
  {
   "id": "s2_mark_2",
   "who": "mark",
   "name": "МАРК",
   "start": 51.98,
   "caption": "У вас же *попугай*.",
   "space": "stairs"
  },
  {
   "id": "s2_galina_3",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 53.49,
   "caption": "Так кот его и *испугался*!",
   "space": "stairs"
  },
  {
   "id": "s2_galina_4",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 58.01,
   "caption": "Ой… Это что, уже *началось*?",
   "space": "stairs"
  },
  {
   "id": "s2_mark_3",
   "who": "mark",
   "name": "МАРК",
   "start": 61.31,
   "caption": "Нет. Идём быстрее.",
   "space": "stairs"
  },
  {
   "id": "s3_galina_1",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 74.48,
   "caption": "Молодой человек, у нас тут *конец света*, а вы в шахматы играете!",
   "space": "bunker"
  },
  {
   "id": "s3_lev_1",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 78.6,
   "caption": "Я думаю.",
   "space": "bunker"
  },
  {
   "id": "s3_galina_2",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 80.43,
   "caption": "Думает он… Хоть бы кто-нибудь объяснил, *что происходит*.",
   "space": "bunker"
  },
  {
   "id": "s3_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 91.32,
   "caption": "Почему у вас *другое время*?",
   "space": "bunker"
  },
  {
   "id": "s3_lev_2",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 94.32,
   "caption": "Хороший *вопрос*.",
   "space": "bunker"
  },
  {
   "id": "s3_lev_3",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 97.38,
   "caption": "Ваши часы *спешат*. Или мои *отстают*.",
   "space": "bunker"
  },
  {
   "id": "s4_announce",
   "who": "announcer",
   "name": "ОПОВЕЩЕНИЕ",
   "start": 104.13,
   "caption": "Внимание. *Угроза отменена*. Немедленно покиньте помещение.",
   "space": null
  },
  {
   "id": "s4_galina_1",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 108.59,
   "caption": "Слава богу! Домой пойду.",
   "space": "bunker"
  },
  {
   "id": "s4_lev_1",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 111.74,
   "caption": "Подождите. Если тревога отменена, почему *сирены* всё ещё работают?",
   "space": "bunker"
  },
  {
   "id": "s4_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 118.3,
   "caption": "Все стойте! *Никто не выходит*, пока это не подтвердят.",
   "space": "bunker"
  },
  {
   "id": "s4_galina_2",
   "who": "galina",
   "name": "ГАЛИНА",
   "start": 122.76,
   "caption": "Да вы что? Сказали же, *отменили*!",
   "space": "bunker"
  },
  {
   "id": "s4_mark_2",
   "who": "mark",
   "name": "МАРК",
   "start": 126.15,
   "caption": "*Сирены* не отменили.",
   "space": "bunker"
  },
  {
   "id": "s5_alisa_1",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 136.77,
   "caption": "Пап, мне *страшно*.",
   "space": "bunker"
  },
  {
   "id": "s5_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 139.0,
   "caption": "Я рядом.",
   "space": "bunker"
  },
  {
   "id": "s5_rescuer_1",
   "who": "rescuer",
   "name": "ГОЛОС ЗА ДВЕРЬЮ",
   "start": 149.97,
   "caption": "Откройте. Это *спасатели*.",
   "space": null
  },
  {
   "id": "s5_mark_2",
   "who": "mark",
   "name": "МАРК",
   "start": 154.11,
   "caption": "Галина Петровна, стойте! *Не открывайте*.",
   "space": "bunker"
  },
  {
   "id": "s5_double_1",
   "who": "double",
   "name": "МАРК?",
   "start": 159.63,
   "caption": "Алиса, открой. *Это папа*.",
   "space": null
  },
  {
   "id": "s5_alisa_2",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 163.21,
   "caption": "Пап… у него *твой голос*.",
   "space": "bunker"
  },
  {
   "id": "s6_lev_1",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 171.68,
   "caption": "Марк. Посмотрите на это.",
   "space": "bunker"
  },
  {
   "id": "s6_double_1",
   "who": "double",
   "name": "МАРК?",
   "start": 177.37,
   "caption": "Марк. Ты уже *один раз* открыл эту дверь.",
   "space": null
  },
  {
   "id": "s6_mark_1",
   "who": "mark",
   "name": "МАРК",
   "start": 181.85,
   "caption": "Это… *я*?",
   "space": "bunker"
  },
  {
   "id": "s6_lev_2",
   "who": "lev",
   "name": "ЛЕВ",
   "start": 185.7,
   "caption": "Похоже, это была *не обычная* ракетная тревога.",
   "space": "bunker"
  },
  {
   "id": "s7_alisa_1",
   "who": "alisa",
   "name": "АЛИСА",
   "start": 198.2,
   "caption": "Пап… а *какой из вас настоящий*?",
   "space": "bunker"
  }
 ],
