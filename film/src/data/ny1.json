{
 "name": "ny1",
 "duration": 41.99,
 "dialogue": [
  {
   "id": "ny1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Официально: новогодние каникулы — *одиннадцать дней*. С тридцать первого декабря по десятое января.",
   "space": null
  },
  {
   "id": "ny1_02",
   "who": "narrator",
   "name": "",
   "start": 6.78,
   "caption": "План Марка: спортзал, английский, выспаться и наконец закрыть все дела.",
   "space": null
  },
  {
   "id": "ny1_03",
   "who": "narrator",
   "name": "",
   "start": 12.56,
   "caption": "День первый: салаты. День второй: салаты. День третий… *какой сегодня день?*",
   "space": null
  },
  {
   "id": "ny1_04",
   "who": "narrator",
   "name": "",
   "start": 20.19,
   "caption": "Седьмое января. Спортзал — ноль. Английский — ноль. Сериал — *сорок восемь серий*.",
   "space": null
  },
  {
   "id": "ny1_05",
   "who": "narrator",
   "name": "",
   "start": 27.6,
   "caption": "Десятое, вечер. Марк понимает: на дела времени не было — он был *очень занят отдыхом*.",
   "space": null
  },
  {
   "id": "ny1_06",
   "who": "narrator",
   "name": "",
   "start": 34.75,
   "caption": "А одиннадцатого — на работу. Подпишись — каждый день новые истории.",
   "space": null
  }
 ],
