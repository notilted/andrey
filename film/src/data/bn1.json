{
 "name": "bn1",
 "duration": 44.62,
 "dialogue": [
  {
   "id": "bn1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Бабушкины два миллиона. Сезон второй. Прошёл год. У тебя три шаурмичные и очередь, которая *не кончается*.",
   "space": null
  },
  {
   "id": "bn1_02",
   "who": "narrator",
   "name": "",
   "start": 8.4,
   "caption": "Каждое утро ты сам маринуешь мясо по бабушкиной тетради. Рецепт не знает *никто*.",
   "space": null
  },
  {
   "id": "bn1_03",
   "who": "narrator",
   "name": "",
   "start": 14.29,
   "caption": "А сегодня в почте — письмо от юристов. Название «Бабушкины» зарегистрировал *кто-то другой*.",
   "space": null
  },
  {
   "id": "bn1_04",
   "who": "narrator",
   "name": "",
   "start": 21.0,
   "caption": "Тридцать дней, чтобы снять все вывески. Иначе — суд и иск *на миллионы*.",
   "space": null
  },
  {
   "id": "bn1_05",
   "who": "narrator",
   "name": "",
   "start": 26.75,
   "caption": "Ты листаешь документы до последней страницы. И видишь имя владельца.",
   "space": null
  },
  {
   "id": "bn1_06",
   "who": "narrator",
   "name": "",
   "start": 31.64,
   "caption": "Это тот самый человек в дорогом костюме. Которому ты год назад *сказал «нет»*.",
   "space": null
  },
  {
   "id": "bn1_07",
   "who": "narrator",
   "name": "",
   "start": 37.39,
   "caption": "Часть вторая — завтра в семь вечера. Подпишись, чтобы не пропустить.",
   "space": null
  }
 ],
