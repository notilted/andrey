{
 "name": "lp1",
 "duration": 42.46,
 "dialogue": [
  {
   "id": "lp1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Потерял телефон? Первые десять минут решают всё. *Четыре шага*.",
   "space": null
  },
  {
   "id": "lp1_02",
   "who": "narrator",
   "name": "",
   "start": 5.24,
   "caption": "Первый: позвони на свой номер с чужого телефона. Вдруг он под диваном — или его нашёл *честный человек*.",
   "space": null
  },
  {
   "id": "lp1_03",
   "who": "narrator",
   "name": "",
   "start": 12.21,
   "caption": "Второй: зайди в «Найти устройство» или «Локатор» с компьютера. Там видно телефон на карте — и его можно *заблокировать*.",
   "space": null
  },
  {
   "id": "lp1_04",
   "who": "narrator",
   "name": "",
   "start": 20.7,
   "caption": "Третий: позвони в банк и заблокируй карты. Это *самое главное*.",
   "space": null
  },
  {
   "id": "lp1_05",
   "who": "narrator",
   "name": "",
   "start": 25.7,
   "caption": "Четвёртый: попроси оператора заблокировать сим-карту. Новую выдадут *с тем же номером*.",
   "space": null
  },
  {
   "id": "lp1_06",
   "who": "narrator",
   "name": "",
   "start": 32.51,
   "caption": "И сохрани IMEI с коробки — пригодится для заявления. Подпишись — а в семь вечера новый сериал «Чужой телефон».",
   "space": null
  }
 ],
