{
 "name": "nz1",
 "duration": 44.47,
 "dialogue": [
  {
   "id": "nz1_01",
   "who": "narrator",
   "name": "",
   "start": 0.05,
   "caption": "Человек ушёл, а завещания нет. Кому достанутся *квартира и деньги*?",
   "space": null
  },
  {
   "id": "nz1_02",
   "who": "narrator",
   "name": "",
   "start": 5.04,
   "caption": "Тогда работает закон — очереди наследников. Первая очередь: дети, супруг и родители. Они делят всё *поровну*.",
   "space": null
  },
  {
   "id": "nz1_03",
   "who": "narrator",
   "name": "",
   "start": 13.26,
   "caption": "Нет никого из первой — наследует вторая: братья, сёстры, бабушки и дедушки.",
   "space": null
  },
  {
   "id": "nz1_04",
   "who": "narrator",
   "name": "",
   "start": 19.42,
   "caption": "А вот с кем прожили двадцать лет без штампа — по закону *не наследник*.",
   "space": null
  },
  {
   "id": "nz1_05",
   "who": "narrator",
   "name": "",
   "start": 24.12,
   "caption": "И главное: на принятие наследства — *шесть месяцев*. Пропустил — восстанавливать срок придётся уже через суд.",
   "space": null
  },
  {
   "id": "nz1_06",
   "who": "narrator",
   "name": "",
   "start": 32.07,
   "caption": "А если наследников нет совсем — всё переходит *государству*.",
   "space": null
  },
  {
   "id": "nz1_07",
   "who": "narrator",
   "name": "",
   "start": 36.46,
   "caption": "Подпишись — каждый день новые истории. А в семь вечера — вторая часть «Без сигнала».",
   "space": null
  }
 ],
