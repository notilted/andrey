{
 "name": "cr1",
 "duration": 53.12,
 "dialogue": [
  {
   "id": "cr1_01",
   "who": "narrator",
   "name": "",
   "start": 0.2,
   "caption": "Тебе шестнадцать. Ты чистишь обувь. Через десять лет весь город будет *бояться твоего имени*.",
   "space": null
  },
  {
   "id": "cr1_02",
   "who": "narrator",
   "name": "",
   "start": 7.07,
   "caption": "Каждое утро — площадь. Пятьдесят песо за пару. На ужин хватает. На мечты — *нет*.",
   "space": null
  },
  {
   "id": "cr1_03",
   "who": "narrator",
   "name": "",
   "start": 14.5,
   "caption": "Сегодня к тебе садится человек в белом костюме. Дон Октавио. *Хозяин города*.",
   "space": null
  },
  {
   "id": "cr1_04",
   "who": "narrator",
   "name": "",
   "start": 20.17,
   "caption": "Ты чистишь его ботинки так, будто от этого зависит твоя жизнь. Он молчит. А потом оставляет на ящике *конверт*.",
   "space": null
  },
  {
   "id": "cr1_05",
   "who": "narrator",
   "name": "",
   "start": 28.66,
   "caption": "Пятьсот долларов. Больше, чем ты заработаешь *за год*.",
   "space": null
  },
  {
   "id": "cr1_06",
   "who": "narrator",
   "name": "",
   "start": 32.37,
   "caption": "А под деньгами — записка: «Завтра. Шесть утра. Гараж на Санта-Ана. Приходи *один*».",
   "space": null
  },
  {
   "id": "cr1_07",
   "who": "narrator",
   "name": "",
   "start": 39.35,
   "caption": "Мама зовёт ужинать. Чино свистит с улицы. А ты смотришь на конверт.",
   "space": null
  },
  {
   "id": "cr1_08",
   "who": "narrator",
   "name": "",
   "start": 44.7,
   "caption": "Пойдёшь — или вернёшь? Пиши цифру. Что выберет большинство — *то и случится*.",
   "space": null
  }
 ],
