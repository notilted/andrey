[
 {
  "id": "e2_galina_1",
  "voice": "galina",
  "text": "Опять стучат...",
  "speed": 0.85,
  "temp": 0.65,
  "note": "шёпотом, в темноте"
 },
 {
  "id": "e2_lev_1",
  "voice": "lev",
  "text": "Время пошло заново.",
  "speed": 0.88,
  "note": "глядя на телефон, спокойно"
 },
 {
  "id": "e2_mark_1",
  "voice": "mark",
  "text": "Что значит — заново?",
  "say": "Что значит, заново?",
  "note": "резко"
 },
 {
  "id": "e2_lev_2",
  "voice": "lev",
  "text": "Значит, мы здесь уже были.",
  "speed": 0.85,
  "note": "тихо"
 },
 {
  "id": "e2_mark_7",
  "voice": "mark",
  "text": "Тринадцатая...",
  "speed": 0.85,
  "temp": 0.6,
  "note": "читая сообщение, шёпотом"
 },
 {
  "id": "e2_galina_5",
  "voice": "galina",
  "text": "Так. Без паники. Я в девяносто восьмом и не такое видела.",
  "speed": 1.02,
  "note": "бодрится, но голос дрожит"
 },
 {
  "id": "e2_parrot_1",
  "voice": "parrot",
  "fx": "parrot",
  "text": "Не открывай. Не открывай.",
  "speed": 1.05,
  "note": "попугай голосом Марка"
 },
 {
  "id": "e2_galina_2",
  "voice": "galina",
  "text": "Кеша! Ты где такого набрался?",
  "speed": 1.05,
  "note": "испуганно-возмущённо"
 },
 {
  "id": "e2_alisa_1",
  "voice": "alisa",
  "text": "Пап... он говорит твоим голосом.",
  "speed": 0.88,
  "note": "тихо"
 },
 {
  "id": "e2_mark_2",
  "voice": "mark",
  "text": "Он не мог этого слышать. Я этого ещё не говорил.",
  "note": "растерянно"
 },
 {
  "id": "e2_lev_3",
  "voice": "lev",
  "text": "Ещё не говорили. В этот раз.",
  "speed": 0.85,
  "note": "с паузой"
 },
 {
  "id": "e2_lev_4",
  "voice": "lev",
  "text": "Двенадцать партий. Я записываю каждую.",
  "speed": 0.9,
  "note": "открывая блокнот"
 },
 {
  "id": "e2_mark_3",
  "voice": "mark",
  "text": "Партий?",
  "speed": 0.95,
  "note": "непонимающе"
 },
 {
  "id": "e2_lev_5",
  "voice": "lev",
  "text": "Когда таймер доходит до нуля, всё начинается снова. И за дверью становится на одного больше.",
  "speed": 0.92,
  "note": "ровно, без нажима"
 },
 {
  "id": "e2_galina_3",
  "voice": "galina",
  "text": "На одного кого?",
  "speed": 0.95,
  "note": "сглотнув"
 },
 {
  "id": "e2_man_1",
  "voice": "rescuer",
  "text": "Да откройте вы уже! Может, там помощь!",
  "speed": 1.05,
  "temp": 0.7,
  "note": "мужчина со скамьи, срываясь"
 },
 {
  "id": "e2_mark_9",
  "voice": "mark",
  "text": "Никто не откроет эту дверь.",
  "speed": 0.95,
  "note": "твёрдо, вставая у двери"
 },
 {
  "id": "e2_mark_8",
  "voice": "mark",
  "text": "А вы? Вы настоящий?",
  "note": "Льву, с подозрением"
 },
 {
  "id": "e2_lev_6",
  "voice": "lev",
  "text": "Я единственный, кто ни разу не открыл эту дверь.",
  "speed": 0.88,
  "note": "спокойно"
 },
 {
  "id": "e2_lev_7",
  "voice": "lev",
  "text": "Ваш ход, Марк.",
  "speed": 0.85,
  "note": "переставляя фигуру"
 },
 {
  "id": "e2_alisa_2",
  "voice": "alisa",
  "text": "Я это нарисовала дома. Но тут было по-другому.",
  "speed": 0.9,
  "note": "доставая рисунок из кармана"
 },
 {
  "id": "e2_mark_4",
  "voice": "mark",
  "text": "Когда ты это нарисовала?",
  "note": "мягко, но тревожно"
 },
 {
  "id": "e2_alisa_3",
  "voice": "alisa",
  "text": "Не помню. Пап, мне кажется, я это уже рисовала. Много раз.",
  "speed": 0.88,
  "note": "растерянно"
 },
 {
  "id": "e2_alisa_6",
  "voice": "alisa",
  "text": "Тут папа держит меня за руку. А этот стоит за дверью.",
  "speed": 0.9,
  "note": "показывая на рисунок"
 },
 {
  "id": "e2_mark_10",
  "voice": "mark",
  "text": "Который из них я?",
  "speed": 0.9,
  "note": "почти неслышно"
 },
 {
  "id": "e2_alisa_7",
  "voice": "alisa",
  "text": "Я не знаю.",
  "speed": 0.85,
  "note": "тихо"
 },
 {
  "id": "e2_lev_8",
  "voice": "lev",
  "text": "Осторожно. Он помнит всё, что помните вы.",
  "speed": 0.9,
  "note": "вслед Марку"
 },
 {
  "id": "e2_mark_11",
  "voice": "mark",
  "text": "Тогда проверим, что помню я.",
  "speed": 0.95,
  "note": "идя к двери"
 },
 {
  "id": "e2_mark_5",
  "voice": "mark",
  "text": "Если ты — это я... скажи, что Алиса рисовала сегодня вечером.",
  "say": "Если ты, это я... скажи, что Алиса рисовала сегодня вечером.",
  "speed": 0.95,
  "note": "у самой двери, вполголоса"
 },
 {
  "id": "e2_double_1",
  "voice": "double",
  "fx": "door",
  "text": "Дом. Солнце. И два дерева.",
  "speed": 0.9,
  "note": "за дверью, без паузы"
 },
 {
  "id": "e2_alisa_4",
  "voice": "alisa",
  "text": "Правильно...",
  "speed": 0.85,
  "fx": "whisper",
  "note": "шёпотом"
 },
 {
  "id": "e2_double_2",
  "voice": "double",
  "fx": "door",
  "text": "Теперь ты ответь. Как зовут маму Алисы?",
  "speed": 0.9,
  "note": "ровно"
 },
 {
  "id": "e2_mark_6",
  "voice": "mark",
  "text": "Я... не помню.",
  "speed": 0.8,
  "temp": 0.6,
  "note": "после долгой паузы, еле слышно"
 },
 {
  "id": "e2_galina_4",
  "voice": "galina",
  "text": "Господи...",
  "speed": 0.85,
  "temp": 0.6,
  "note": "шёпотом"
 },
 {
  "id": "e2_mark_12",
  "voice": "mark",
  "text": "Алиса... как зовут маму?",
  "speed": 0.88,
  "note": "поворачиваясь к дочери"
 },
 {
  "id": "e2_alisa_8",
  "voice": "alisa",
  "text": "Пап... ты же сам сказал. Её имя нельзя называть.",
  "speed": 0.85,
  "note": "испуганно"
 },
 {
  "id": "e2_alisa_5",
  "voice": "alisa",
  "text": "Пап?..",
  "say": "Пап?",
  "speed": 0.85,
  "note": "отступая"
 },
 {
  "id": "e2_double_3",
  "voice": "double",
  "text": "Алиса. Пойдём домой.",
  "speed": 0.88,
  "temp": 0.55,
  "note": "из открытой двери, ласково"
 }
]