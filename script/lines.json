[
 {
  "id": "s1_announce",
  "voice": "announcer",
  "fx": "loudspeaker",
  "text": "Внимание! Ракетная опасность. Всем немедленно пройти в ближайшее укрытие.",
  "note": "уличный громкоговоритель"
 },
 {
  "id": "s1_alisa_1",
  "voice": "alisa",
  "text": "Пап... а что это значит?",
  "speed": 0.95,
  "note": "тихое беспокойство"
 },
 {
  "id": "s1_mark_1",
  "voice": "mark",
  "text": "Одевайся. Нам нужно в укрытие.",
  "speed": 1.03,
  "note": "сдержанная срочность"
 },
 {
  "id": "s1_alisa_2",
  "voice": "alisa",
  "text": "А куда мы пойдём?",
  "note": "встревоженно, натягивая кофту"
 },
 {
  "id": "s1_mark_3",
  "voice": "mark",
  "text": "В подвал. Там убежище.",
  "note": "спокойно, чтобы не пугать"
 },
 {
  "id": "s1_mark_2",
  "voice": "mark",
  "text": "Это... мой номер.",
  "speed": 0.9,
  "temp": 0.6,
  "note": "почти шёпотом, растерянно"
 },
 {
  "id": "s2_mark_0",
  "voice": "mark",
  "text": "Держись за перила. Не беги.",
  "note": "на ходу, заботливо"
 },
 {
  "id": "s2_galina_1",
  "voice": "galina",
  "text": "Подождите! А животных-то брать разрешили?",
  "speed": 1.05,
  "note": "запыхавшись, громко"
 },
 {
  "id": "s2_mark_1",
  "voice": "mark",
  "text": "Думаю, да.",
  "note": "коротко, на ходу"
 },
 {
  "id": "s2_galina_2",
  "voice": "galina",
  "text": "А то я кота потеряла.",
  "note": "сокрушённо"
 },
 {
  "id": "s2_mark_2",
  "voice": "mark",
  "text": "У вас же попугай.",
  "note": "с недоумением"
 },
 {
  "id": "s2_galina_3",
  "voice": "galina",
  "text": "Так кот его и испугался!",
  "speed": 1.05,
  "note": "как само собой разумеющееся"
 },
 {
  "id": "s2_galina_4",
  "voice": "galina",
  "text": "Ой... Это что, уже началось?",
  "speed": 0.95,
  "note": "испуганно, когда мигнул свет"
 },
 {
  "id": "s2_mark_3",
  "voice": "mark",
  "text": "Нет. Идём быстрее.",
  "note": "твёрдо"
 },
 {
  "id": "s3_galina_1",
  "voice": "galina",
  "text": "Молодой человек, у нас тут конец света, а вы в шахматы играете!",
  "speed": 1.05,
  "note": "возмущённо"
 },
 {
  "id": "s3_lev_1",
  "voice": "lev",
  "text": "Я думаю.",
  "speed": 0.9,
  "note": "спокойно, не поднимая глаз"
 },
 {
  "id": "s3_galina_2",
  "voice": "galina",
  "text": "Думает он... Хоть бы кто-нибудь объяснил, что происходит.",
  "note": "ворчливо, садясь на скамейку"
 },
 {
  "id": "s3_mark_1",
  "voice": "mark",
  "text": "Почему у вас другое время?",
  "note": "насторожённо"
 },
 {
  "id": "s3_lev_2",
  "voice": "lev",
  "text": "Хороший вопрос.",
  "speed": 0.85,
  "note": "спокойная подозрительность"
 },
 {
  "id": "s3_lev_3",
  "voice": "lev",
  "text": "Ваши часы спешат. Или мои отстают.",
  "speed": 0.88,
  "note": "задумчиво, глядя на доску"
 },
 {
  "id": "s4_announce",
  "voice": "announcer",
  "fx": "loudspeaker",
  "text": "Внимание. Угроза отменена. Немедленно покиньте помещение.",
  "note": "динамик убежища"
 },
 {
  "id": "s4_galina_1",
  "voice": "galina",
  "text": "Слава богу! Домой пойду.",
  "note": "облегчение"
 },
 {
  "id": "s4_lev_1",
  "voice": "lev",
  "text": "Подождите. Если тревога отменена, почему сирены всё ещё работают?",
  "speed": 0.95,
  "note": "негромко, но все замирают"
 },
 {
  "id": "s4_mark_1",
  "voice": "mark",
  "text": "Все стойте! Никто не выходит, пока это не подтвердят.",
  "speed": 1.02,
  "note": "твёрдо"
 },
 {
  "id": "s4_galina_2",
  "voice": "galina",
  "text": "Да вы что? Сказали же, отменили!",
  "speed": 1.05,
  "note": "возмущённо",
  "say": "Да вы что? Сказали же, отменили."
 },
 {
  "id": "s4_mark_2",
  "voice": "mark",
  "text": "Сирены не отменили.",
  "speed": 0.95,
  "note": "тихо и твёрдо"
 },
 {
  "id": "s5_alisa_1",
  "voice": "alisa",
  "text": "Пап, мне страшно.",
  "speed": 0.9,
  "note": "тихо, дрожащим голосом"
 },
 {
  "id": "s5_mark_1",
  "voice": "mark",
  "text": "Я рядом.",
  "speed": 0.88,
  "temp": 0.6,
  "note": "мягко"
 },
 {
  "id": "s5_rescuer_1",
  "voice": "rescuer",
  "fx": "door",
  "text": "Откройте. Это спасатели.",
  "note": "за металлической дверью"
 },
 {
  "id": "s5_mark_2",
  "voice": "mark",
  "text": "Галина Петровна, стойте! Не открывайте.",
  "speed": 1.05,
  "note": "резко, шёпотом-криком"
 },
 {
  "id": "s5_double_1",
  "voice": "double",
  "fx": "door",
  "text": "Алиса, открой. Это папа.",
  "note": "голос Марка за дверью, слишком спокойный"
 },
 {
  "id": "s5_alisa_2",
  "voice": "alisa",
  "text": "Пап... у него твой голос.",
  "speed": 0.85,
  "fx": "whisper",
  "note": "шёпотом, тихий страх"
 },
 {
  "id": "s6_lev_1",
  "voice": "lev",
  "text": "Марк. Посмотрите на это.",
  "speed": 0.9,
  "note": "тихо подзывает"
 },
 {
  "id": "s6_double_1",
  "voice": "double",
  "fx": "monitor",
  "text": "Марк. Ты уже один раз открыл эту дверь.",
  "speed": 0.92,
  "note": "из динамика монитора, ровно"
 },
 {
  "id": "s6_mark_1",
  "voice": "mark",
  "text": "Это... я?",
  "speed": 0.85,
  "note": "еле слышно"
 },
 {
  "id": "s6_lev_2",
  "voice": "lev",
  "text": "Похоже, это была не обычная ракетная тревога.",
  "speed": 0.88,
  "note": "тихо, сам себе"
 },
 {
  "id": "s7_alisa_1",
  "voice": "alisa",
  "text": "Пап... а какой из вас настоящий?",
  "speed": 0.85,
  "note": "растерянность и тревога"
 }
]